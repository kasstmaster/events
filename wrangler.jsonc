{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "events",
  "account_id": "37d068144865a0b725ee272bc7b2eb71",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "keep_vars": true,
  // Recovery wake-up for the transactional routing outbox; disabled by runtime flag.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "EVENTS_DATABASE", "class_name": "EventsDatabase" }],
  },
  "migrations": [
    { "tag": "events-v1", "new_sqlite_classes": ["EventsDatabase"] },
  ],
}
